# Unity-recommended .gitattributes
# Ensures consistent line endings and correct binary handling

# Force LF for all text files
* text=auto eol=lf

# Unity YAML files — treat as text
*.cs      text eol=lf
*.shader  text eol=lf
*.mat     text eol=lf
*.anim    text eol=lf
*.prefab  text eol=lf
*.unity   text eol=lf
*.asset   text eol=lf
*.meta    text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.xml     text eol=lf
*.html    text eol=lf

# Binary files — never diff or merge
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.psd     binary
*.ai      binary
*.mp3     binary
*.ogg     binary
*.wav     binary
*.aif     binary
*.aiff    binary
*.it      binary
*.mod     binary
*.s3m     binary
*.xm      binary
*.fbx     binary
*.glb     binary
*.gltf    text eol=lf
*.dll     binary
*.exe     binary
*.so      binary
*.dylib   binary
*.a       binary
*.lib     binary
*.zip     binary
*.7z      binary
*.gz      binary
*.apk     binary
*.unitypackage binary
*.jks     binary
